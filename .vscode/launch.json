{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "BlinkitPhase1Application",
            "request": "launch",
            "mainClass": "com.blinkit.phase1.BlinkitPhase1Application",
            "projectName": "blinkit-phase1-starter"
        },
        {
            "type": "java",
            "name": "GC Stress Test (with GC Logging)",
            "request": "launch",
            "mainClass": "com.blinkit.phase1.stress.GCStressTest",
            "projectName": "blinkit-phase1-starter",
            "vmArgs": "-Xms256m -Xmx256m -Xlog:gc*:stdout:time",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "GC Stress Test (Small Heap - 128MB)",
            "request": "launch",
            "mainClass": "com.blinkit.phase1.stress.GCStressTest",
            "projectName": "blinkit-phase1-starter",
            "vmArgs": "-Xms128m -Xmx128m -Xlog:gc*:stdout:time",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "GC Stress Test (Large Heap - 512MB)",
            "request": "launch",
            "mainClass": "com.blinkit.phase1.stress.GCStressTest",
            "projectName": "blinkit-phase1-starter",
            "vmArgs": "-Xms512m -Xmx512m -Xlog:gc*:stdout:time",
            "console": "integratedTerminal"
        }
    ]
}